# Copia este archivo a /etc/crucidrive/api.env en la VM y completa los valores.
# NO lo subas al repo con valores reales. Permisos: chmod 640, chown root:crucidrive.

# Supabase (Settings → API). La service_role es la clave más sensible: solo aquí.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Caddy está delante: confiar en un proxy (sin esto el límite de peticiones ve una sola IP).
TRUST_PROXY=1

# Orígenes web permitidos (el APK no manda Origin y no lo necesita). Ejemplo: la web de Vercel.
ALLOWED_ORIGINS=

# Avisos con la app cerrada (Expo). Necesario si activaste la seguridad reforzada en Expo.
EXPO_ACCESS_TOKEN=
AVISOS_ACTIVOS=true

# No pongas aquí SMOKE_* ni PORT (lo fija el servicio).
