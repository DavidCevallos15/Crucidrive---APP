{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["jest"],
    "paths": {
      "@constants/*": ["src/constants/*"],
      "@store/*": ["src/store/*"]
    }
  },
  "include": ["tests/**/*.ts", "src/**/*.ts"]
}
