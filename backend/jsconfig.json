{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "useUnknownInCatchVariables": false
  },
  "include": ["src/**/*.js", "src/**/*.d.ts", "scripts/**/*.js"]
}
