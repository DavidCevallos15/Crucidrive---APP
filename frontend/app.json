{
  "expo": {
    "name": "CruciDrive",
    "slug": "crucidrive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "crucidrive",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.crucidrive.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.crucidrive.app",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "CruciDrive necesita tu galer\u00eda para que elijas las fotos de verificaci\u00f3n.",
          "cameraPermission": "CruciDrive necesita la c\u00e1mara para tomar tu foto, la de tu c\u00e9dula y la de tu tricimoto."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CruciDrive usa tu ubicaci\u00f3n para mostrarte tricimotos cercanas y, si eres conductor y est\u00e1s disponible, para ofrecerte viajes aunque la app est\u00e9 en segundo plano.",
          "locationWhenInUsePermission": "CruciDrive necesita acceder a tu ubicaci\u00f3n para mostrarte tricimotos cercanas.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "d3890399-716a-4a8c-847b-e1944c14a8d1"
      }
    }
  }
}
