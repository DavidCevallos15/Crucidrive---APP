# ─── CruciDrive — Variables de Entorno del Backend ───────────
# Copia este archivo como .env y completa los valores.
# IMPORTANTE: Nunca subas el archivo .env al repositorio.

# Puerto del servidor Express
PORT=3000

# URL del proyecto de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase (NO la clave de servicio)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Orígenes permitidos para CORS (separados por coma, sin espacios)
# En producción, restringir a los dominios reales de la app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
