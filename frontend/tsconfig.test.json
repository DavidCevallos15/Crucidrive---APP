{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "types": ["jest", "node"],
    "paths": {
      "@constants/*": ["./src/constants/*"],
      "@store/*": ["./src/store/*"]
    }
  },
  "include": ["tests/**/*.ts", "src/**/*.ts"]
}
