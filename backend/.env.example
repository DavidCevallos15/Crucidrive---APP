# ─── CruciDrive — Variables de entorno del backend ───────────
# Copia este archivo como .env y completa los valores. Nunca subas .env al repo.

# Proyecto de Supabase (Settings → API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anon

# Clave de servicio: SOLO en el servidor, nunca en el frontend.
# Opcional hasta el paso 003 (despacho). Ignora RLS: úsala solo para tareas del sistema.
SUPABASE_SERVICE_ROLE_KEY=

# Puerto del servidor Express + Socket.io
PORT=3000

# Orígenes permitidos para CORS (navegador/PWA), separados por coma.
# Las apps nativas no envían Origin y no se ven afectadas.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Número de proxies delante del servidor (Render/Railway: 1). Vacío en local.
TRUST_PROXY=

# Peticiones por IP cada 15 min. Holgado porque las operadoras móviles comparten IP (CGNAT).
RATE_LIMIT_API=600
RATE_LIMIT_AUTH=60
