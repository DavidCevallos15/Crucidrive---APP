# ─── CruciDrive — Variables de Entorno del Frontend ──────────
# Copia este archivo como .env y completa los valores.
# IMPORTANTE: Nunca subas el archivo .env al repositorio.

# URL del proyecto de Supabase
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase (NO la clave de servicio)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL base del servidor Express (backend)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# URL del servidor de WebSockets (generalmente igual al backend)
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000

# ─── Builds de EAS (APK) ─────────────────────────────────────
# Este .env NO sube a EAS (está en .gitignore). Para un APK, las 4 variables de arriba van
# como variables de EAS en el entorno del perfil (preview o production; eas.json lo indica):
#   npx eas-cli env:create --environment preview --name EXPO_PUBLIC_SUPABASE_URL --value ... --visibility plaintext
# En un APK, API_BASE_URL y SOCKET_URL deben ser la URL pública del backend (https), no localhost
# ni la IP de tu PC.
#
# Clave de Google Maps para Android (también como variable de EAS, no aquí). Sin ella el APK
# muestra "Mapa no disponible". Restríngela en Google Cloud a com.crucidrive.app + SHA-1.
#   GOOGLE_MAPS_API_KEY=
